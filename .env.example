APP_NAME=RoadToSchool
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=road_to_school
DB_USERNAME=roadtoschool
DB_PASSWORD=roadtoschool_local

BROADCAST_CONNECTION=reverb
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@roadtoschool.local
MAIL_FROM_NAME="${APP_NAME}"

REVERB_APP_ID=roadtoschool-local
REVERB_APP_KEY=roadtoschool-local-key
REVERB_APP_SECRET=roadtoschool-local-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

RECOMMENDATION_ENDPOINT=
RECOMMENDATION_APP_ID=1
RECOMMENDATION_CONNECT_TIMEOUT=1
RECOMMENDATION_TIMEOUT=3
